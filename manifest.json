{
  "manifest_version": 3,
  "name": "Price To Hours",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com.au/*", "https://www.umart.com.au/*", "https://www.ebay.com.au/*", "https://www.facebook.com/*"],
      "js": ["content.js"]
    }
  ],

  
  "permissions": [
    "storage",
    "activeTab"
  ],

  "action": {
      "default_popup": "hello.html",
      "default_icon": "logo.png"
  },

  "background": {
    "service_worker": "background.js"
  }
}